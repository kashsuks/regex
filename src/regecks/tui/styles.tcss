Screen {
    background: $background;
}

#main {
    padding: 1 2;
}

.field-label {
    color: $text-muted;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

Input {
    margin-bottom: 0;
}

Input:focus {
    border: tall $accent;
}

#controls {
    margin-top: 1;
    height: auto;
    align: left middle;
}

#mode {
    height: auto;
    border: none;
    background: transparent;
    padding: 0;
}

#error-msg {
    color: $error;
    background: $error 10%;
    border: solid $error;
    padding: 0 1;
    margin-top: 1;
    height: auto;
}

#match-count {
    color: $success;
    background: $success 10%;
    padding: 0 1;
    margin-top: 1;
    height: auto;
    text-style: bold;
}

HighlightView {
    height: auto,
    min-height: 3,
    border: solid $surface-lighten-2;
    padding: 0 1;
    margin-top: 1;
    background: $surface;
}

MatchTable {
    height: auto;
    min-height: 5;
    margin-top: 1;
}

DataTable {
    background: $surface;
}

DataTable > .datatable--header {
    background: $surface-lighten-1;
    color: $text-muted;
    text-style: bold;
}

.hidden {
    display: none;
}
